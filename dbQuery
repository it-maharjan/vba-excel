Option Explicit

Sub btnTestConnection()
    
    Dim cn As ADODB.Connection
    Dim rs As ADODB.Recordset
    Dim fid As ADODB.FieldAttributeEnum
    Dim mssql As String
    
    Dim servername As String
    Dim userid As String
    Dim pwd As String
    Dim database As String
    
    servername = Sheets("SQLParams").Range("B2")
    userid = Sheets("SQLParams").Range("B3")
    pwd = Sheets("SQLParams").Range("B4")
    database = Sheets("SQLParams").Range("B5")
    
    Set cn = New ADODB.Connection
    Set rs = New ADODB.Recordset
    
    If Sheets("SQLParams").Range("C5").Value = True Then
        cn.ConnectionString = "Provider=MSOLEDBSQL;Data Source=" & servername & _
        ";Initial Catalog=" & database & _
        ";Integrated Security=SSPI;Trusted_Connection=yes;"
    Else
         cn.ConnectionString = "Provider=MSOLEDBSQL;Data Source=" & servername & _
         ";Initial Catalog=" & database & ";User ID=" & userid & ";Password=" & pwd & ";TrustServerCertificate=yes;"
    End If
    
    
    

    On Error GoTo ErrorHandler
    
    cn.ConnectionTimeout = 100
    cn.Open
    
    If cn.State = adStateOpen Then
        MsgBox "Connection has been tested successfully!!", vbOKOnly, "Connection Result"
        cn.Close
    End If
    Exit Sub
    
ErrorHandler:
    MsgBox "Error:" & Err.Description, vbCritical, "Database connection failed"

End Sub
